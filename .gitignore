# ============================================
# FINAL OUTPUT - KEEP THESE (checked in)
# ============================================
# These are the production output files
!final_output/
!final_output/**

# ============================================
# GLOBAL LARGE FILE EXCLUSIONS
# ============================================
# Model files
*.model
*.model.*
*.bin
*.safetensors
*.kv
*.kv.*
*.vec
*.pt
*.pth
*.npy
*.pkl

# Large data files
*.parquet
*.ttf

# Cache
cache/
data/exports/

# ============================================
# V1 - Neural Vec2Vec
# ============================================
heiro_v1/models/*.pt
heiro_v1/models/*.bin
heiro_v1/models/*/*.json
heiro_v1/models/*/*/*.json

# ============================================
# V5 - Data Collection & Baseline
# ============================================
heiro_v5_getdata/data/raw/*.parquet
heiro_v5_getdata/data/raw/*.json
heiro_v5_getdata/data/processed/*.txt
heiro_v5_getdata/data/processed/*.tsv
heiro_v5_getdata/data/processed/*.zip
heiro_v5_getdata/data/processed/glove*
heiro_v5_getdata/scrapers/data/raw/*.json

# Keep small metadata
!heiro_v5_getdata/data/processed/alignment_results.json
!heiro_v5_getdata/data/processed/corpus_statistics.json

# ============================================
# V6 - BERT
# ============================================
heiro_v6_BERT/data/raw/*.parquet
heiro_v6_BERT/data/raw/*.json
heiro_v6_BERT/data/raw/*.ttf
heiro_v6_BERT/data/processed/*.txt
heiro_v6_BERT/data/processed/*.pkl
heiro_v6_BERT/data/processed/*.json
heiro_v6_BERT/models/*.model
heiro_v6_BERT/models/*.bin
heiro_v6_BERT/models/*.safetensors
